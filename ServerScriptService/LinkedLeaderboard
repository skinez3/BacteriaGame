local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local deadBacteriaModel = ServerStorage:WaitForChild("Foods"):WaitForChild("DeadBacteria")
local foodsFolder = Workspace:WaitForChild("Foods")

local function onHumanoidDied(humanoid, player)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then return end
	
	local points = stats:FindFirstChild("Points")
	if points then
		-- Mark the player as being eaten
		if humanoid.Parent then
			humanoid.Parent:SetAttribute("eating", true)
		end
		
		local pointValue = tonumber(points.Value) or 0
		
		-- If the player had more than 100 points, spawn remains
		if pointValue > 100 then
			local droppedFood = deadBacteriaModel:Clone()
			
			-- The player drops 50% of their points
			local dropAmount = math.floor(pointValue * 0.5)
			droppedFood:SetAttribute("food", dropAmount)
			
			droppedFood.Parent = foodsFolder
			
			-- Spawn loot slightly above the head position
			local head = humanoid.Parent:FindFirstChild("Head")
			if head then
				droppedFood.CFrame = head.CFrame * CFrame.new(0, 3, 0)
			end
		end
		
		-- Reset points on death
		points.Value = 0
	end
end

local function onCharacterAdded(character, player)
	local humanoid = character:WaitForChild("Humanoid")
	humanoid.Died:Connect(function()
		onHumanoidDied(humanoid, player)
	end)
end

local function onPlayerAdded(player)
	-- Create leaderstats folder
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	stats.Parent = player

	-- Use IntValue for correct sorting in the Roblox leaderboard
	local points = Instance.new("IntValue")
	points.Name = "Points"
	points.Value = 0
	points.Parent = stats

	-- Modern method to track character spawning
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(character, player)
	end)
	
	-- If the character has already loaded by this point
	if player.Character then
		onCharacterAdded(player.Character, player)
	end
end

-- Connect the function to the player join event
Players.PlayerAdded:Connect(onPlayerAdded)


